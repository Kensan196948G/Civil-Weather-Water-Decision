APP_ENV=local
APP_NAME=Civil-Weather-Water-Decision
APP_TIMEZONE=Asia/Tokyo

# PoC は SQLite、本番候補は PostgreSQL
# DATABASE_URL=sqlite:///./civil_weather_water.db
DATABASE_URL=postgresql+psycopg2://cw_user:cw_password@localhost:5432/civil_weather_water

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
JMA_XML_BASE_URL=https://xml.kishou.go.jp
WBGT_BASE_URL=https://www.wbgt.env.go.jp

ENABLE_AUTH=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

ENABLE_SCHEDULER=true
PROBE_INTERVAL_SECONDS=300
FORECAST_REFRESH_SECONDS=300

CORS_ORIGINS=*
LOG_LEVEL=INFO
DATA_FETCH_TIMEOUT_SECONDS=20
DATA_FETCH_RETRY_COUNT=3
