APP_ENV=local
APP_NAME=Civil-Weather-Water-Decision
APP_TIMEZONE=Asia/Tokyo

# Local Docker Compose PostgreSQL（local専用。共有環境では強い値へ変更）
POSTGRES_DB=civil_weather_water
POSTGRES_USER=cw_user
# 必須: `openssl rand -base64 24` 等で生成して設定
POSTGRES_PASSWORD=
PG_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# 単体起動の既定は SQLite。Docker Compose では docker-compose.yml が PostgreSQL 接続へ上書きする。
# 非ComposeでPostgreSQLを使う場合はパスワードを含む完全な接続文字列へ置き換える。
DATABASE_URL=sqlite:///./civil_weather_water.db
# Neon の pg_dump/pg_restore 用 direct/unpooled URL（通常のアプリ接続が pooled の場合に設定）
DATABASE_URL_DIRECT=

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
JMA_XML_BASE_URL=https://xml.kishou.go.jp
WBGT_BASE_URL=https://www.wbgt.env.go.jp
# 環境省WBGT予報の地点コード（例: 44132=東京）。設定時のみ公式予報値を採用し、
# 未設定なら気温湿度からの推定のみ。地点コードは環境省 熱中症予防情報サイトの地点一覧を参照。
# 現場別の最寄り地点自動選定は #29（観測所マスタ正規化）で対応予定。
WBGT_STATION_CODE=

ENABLE_AUTH=true
# local でも固定値の流用を避ける。本番(APP_ENV != local)では32バイト以上のランダム値が必須。
JWT_SECRET=
# AI APIキー等の設定値暗号化専用鍵。本番(APP_ENV != local)では32バイト以上のランダム値が必須。
# 既存の暗号化済み設定がある環境では、変更前に再設定・ローテーション手順を確認すること。
SETTINGS_ENCRYPTION_KEY=
# 鍵ローテーション中だけ使う復号専用の旧鍵（カンマ区切り）。設定時は各値32バイト以上。
# 暗号化は常に SETTINGS_ENCRYPTION_KEY で行う。再暗号化後は空に戻す。
SETTINGS_ENCRYPTION_PREVIOUS_KEYS=
JWT_EXPIRE_MINUTES=480
# 本番の初期管理者パスワード（local ではデモユーザー admin/admin123 等を自動投入）
ADMIN_PASSWORD=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

ENABLE_SCHEDULER=true
PROBE_INTERVAL_SECONDS=300
FORECAST_REFRESH_SECONDS=300
NOTIFICATION_DISPATCH_SECONDS=300
NOTIFICATION_DEDUP_SECONDS=3600

# local の簡易検証では * 可。本番(APP_ENV != local)では https オリジンの明示指定が必須。
# 例: CORS_ORIGINS=https://cwwd.mirai-dx-platform.com
CORS_ORIGINS=*
LOG_LEVEL=INFO
DATA_FETCH_TIMEOUT_SECONDS=20
DATA_FETCH_RETRY_COUNT=3
