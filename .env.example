APP_ENV=local
APP_NAME=Civil-Weather-Water-Decision
APP_TIMEZONE=Asia/Tokyo

# PoC は SQLite、本番候補は PostgreSQL
# DATABASE_URL=sqlite:///./civil_weather_water.db
DATABASE_URL=postgresql+psycopg2://cw_user:cw_password@localhost:5432/civil_weather_water

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# 海洋予報（波高・周期・波向・うねり）。Open-Meteo Marine API（APIキー不要）
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1
JMA_XML_BASE_URL=https://xml.kishou.go.jp
WBGT_BASE_URL=https://www.wbgt.env.go.jp
# 環境省WBGT予報の地点コード（例: 44132=東京）。設定時のみ公式予報値を採用し、
# 未設定なら気温湿度からの推定のみ。地点コードは環境省 熱中症予防情報サイトの地点一覧を参照。
# 現場別の最寄り地点自動選定は #29（観測所マスタ正規化）で対応予定。
WBGT_STATION_CODE=

ENABLE_AUTH=true
# 本番(APP_ENV != local)では JWT_SECRET を 32バイト以上のランダム値で必ず設定（未設定だと起動失敗）
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# 本番の初期管理者パスワード（local ではデモユーザー admin/admin123 等を自動投入）
ADMIN_PASSWORD=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

ENABLE_SCHEDULER=true
PROBE_INTERVAL_SECONDS=300
FORECAST_REFRESH_SECONDS=300

# 本番(APP_ENV != local)では https://cwwd.mirai-dx-platform.com のように
# 本番フロントのオリジンのみをカンマ区切りで設定（IP直指定不可。ワイルドカード不可）。
# local 開発時は * を使用可。
CORS_ORIGINS=*
# 設定値（AI APIキー等）の暗号化専用鍵。本番では32バイト以上のランダム値で必ず設定。
# local/test では未設定時のみ JWT_SECRET へフォールバックする。
SETTINGS_ENCRYPTION_KEY=
LOG_LEVEL=INFO
DATA_FETCH_TIMEOUT_SECONDS=20
DATA_FETCH_RETRY_COUNT=3

# デモ・サンプルデータ（現場・作業予定・判断履歴等）を seed するか。
# 未設定の場合: local のみ true / 本番(app_env != local)は false（新規DBにデモ現場を入れない）。
# 検証環境で明示的にデモデータが必要な場合のみ true を設定する。
SEED_DEMO_DATA=
