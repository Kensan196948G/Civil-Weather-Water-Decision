[Unit]
Description=Periodic Civil-Weather-Water-Decision Cloudflare Tunnel config check
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/deploy.md

[Timer]
OnBootSec=9min
OnUnitActiveSec=30min
RandomizedDelaySec=3min
AccuracySec=1min
Persistent=false
Unit=cwwd-cloudflared-config-check.service

[Install]
WantedBy=timers.target
