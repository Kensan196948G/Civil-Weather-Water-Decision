[Unit]
Description=Civil-Weather-Water-Decision Cloudflare Tunnel (cwwd.mirai-dx-platform.com)
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/deploy.md
After=network-online.target cwwd-backend.service cwwd-frontend.service
Wants=network-online.target cwwd-backend.service cwwd-frontend.service

[Service]
Type=simple
User=kensan
Restart=always
RestartSec=5
ExecStart=/usr/local/bin/cloudflared tunnel --config /home/kensan/.cloudflared/config-cwwd.yml run cwwd-civil-weather-water
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private
RemoveIPC=true
UMask=0077

[Install]
WantedBy=multi-user.target
