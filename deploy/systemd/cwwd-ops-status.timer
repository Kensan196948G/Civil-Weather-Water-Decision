[Unit]
Description=Regular Civil-Weather-Water-Decision operations status snapshot
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/deploy.md

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min
RandomizedDelaySec=2min
AccuracySec=1min
Persistent=false
Unit=cwwd-ops-status.service

[Install]
WantedBy=timers.target
