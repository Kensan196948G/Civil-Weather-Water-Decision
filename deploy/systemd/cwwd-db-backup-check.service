[Unit]
Description=Civil-Weather-Water-Decision PostgreSQL backup freshness check
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/backup-restore.md
OnFailure=cwwd-db-backup-failure@%n.service

[Service]
Type=oneshot
User=kensan
Group=kensan
ExecStart=/home/kensan/Projects/Mirai-DX-Project/Civil-Weather-Water-Decision/deploy/scripts/db-backup-check.sh --backup-dir /var/backups/cwwd/postgres --warn-age-hours 24 --max-age-hours 26 --env-file /home/kensan/.config/cwwd/db-backup.env
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private
RemoveIPC=true
UMask=0077
