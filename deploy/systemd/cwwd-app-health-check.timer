[Unit]
Description=Frequent Civil-Weather-Water-Decision application health check
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/deploy.md

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30s
AccuracySec=30s
Persistent=false
Unit=cwwd-app-health-check.service

[Install]
WantedBy=timers.target
