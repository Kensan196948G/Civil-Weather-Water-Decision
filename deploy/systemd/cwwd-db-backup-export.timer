[Unit]
Description=Daily encrypted Civil-Weather-Water-Decision PostgreSQL backup export
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/backup-restore.md

[Timer]
OnCalendar=*-*-* 03:10:00
RandomizedDelaySec=30min
AccuracySec=5min
Persistent=true
Unit=cwwd-db-backup-export.service

[Install]
WantedBy=timers.target
