[Unit]
Description=Daily Civil-Weather-Water-Decision PostgreSQL logical backup
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/backup-restore.md

[Timer]
OnCalendar=*-*-* 02:10:00
RandomizedDelaySec=30min
AccuracySec=5min
Persistent=true
Unit=cwwd-db-backup.service

[Install]
WantedBy=timers.target
