[Unit]
Description=Daily Civil-Weather-Water-Decision offsite backup transfer
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/backup-restore.md

[Timer]
OnCalendar=*-*-* 04:30:00
RandomizedDelaySec=30min
AccuracySec=5min
Persistent=true
Unit=cwwd-db-backup-offsite-transfer.service

[Install]
WantedBy=timers.target
