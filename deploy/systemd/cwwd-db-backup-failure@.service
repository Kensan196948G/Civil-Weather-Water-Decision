[Unit]
Description=Civil-Weather-Water-Decision PostgreSQL backup failure alert for %i
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/backup-restore.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kensan
Group=kensan
EnvironmentFile=-/home/kensan/.config/cwwd/ops-alert.env
ExecStart=/home/kensan/Projects/Mirai-DX-Project/Civil-Weather-Water-Decision/deploy/scripts/ops-alert.sh --title "CWWD PostgreSQL backup failure: %i" --message "Failed systemd unit: %i. Check: journalctl -u %i -n 120 --no-pager" --severity alert --max-chars 3500
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private
RemoveIPC=true
UMask=0077
