[Unit]
Description=Civil-Weather-Water-Decision encrypted PostgreSQL backup export freshness check
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/backup-restore.md
OnFailure=cwwd-db-backup-failure@%n.service

[Service]
Type=oneshot
User=kensan
Group=kensan
ExecStartPre=/usr/bin/test -f /home/kensan/.config/cwwd/backup-export.passphrase
ExecStartPre=/usr/bin/test -r /var/backups/cwwd/exports
ExecStart=/home/kensan/Projects/Mirai-DX-Project/Civil-Weather-Water-Decision/deploy/scripts/db-backup-export-check.sh --export-dir /var/backups/cwwd/exports --warn-age-hours 26 --max-age-hours 28 --passphrase-file /home/kensan/.config/cwwd/backup-export.passphrase
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private
RemoveIPC=true
UMask=0077
