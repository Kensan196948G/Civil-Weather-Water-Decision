[Unit]
Description=Civil-Weather-Water-Decision security surface check
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/deploy.md
After=cwwd-backend.service cwwd-frontend.service
Wants=cwwd-backend.service cwwd-frontend.service
OnFailure=cwwd-ops-failure@%n.service

[Service]
Type=oneshot
User=kensan
Group=kensan
WorkingDirectory=/home/kensan/Projects/Mirai-DX-Project/Civil-Weather-Water-Decision
ExecStart=/home/kensan/Projects/Mirai-DX-Project/Civil-Weather-Water-Decision/deploy/scripts/security-surface-check.sh --backend-url http://127.0.0.1:55019 --frontend-url http://127.0.0.1:34979/ --timeout-seconds 10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
