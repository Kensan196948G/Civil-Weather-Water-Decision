[Unit]
Description=Periodic Civil-Weather-Water-Decision systemd timer freshness check
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/deploy.md

[Timer]
OnBootSec=12min
OnUnitActiveSec=30min
RandomizedDelaySec=3min
AccuracySec=1min
Persistent=false
Unit=cwwd-systemd-timer-freshness-check.service

[Install]
WantedBy=timers.target
