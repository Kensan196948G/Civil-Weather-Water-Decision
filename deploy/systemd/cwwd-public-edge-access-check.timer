[Unit]
Description=Periodic Civil-Weather-Water-Decision public Cloudflare Access coverage check
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/deploy.md

[Timer]
OnBootSec=10min
OnUnitActiveSec=15min
RandomizedDelaySec=2min
AccuracySec=1min
Persistent=false
Unit=cwwd-public-edge-access-check.service

[Install]
WantedBy=timers.target
