[Unit]
Description=Civil-Weather-Water-Decision public Cloudflare Access coverage check
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/deploy.md
After=network-online.target
Wants=network-online.target
OnFailure=cwwd-ops-failure@%n.service

[Service]
Type=oneshot
User=kensan
Group=kensan
WorkingDirectory=/home/kensan/Projects/Mirai-DX-Project/Civil-Weather-Water-Decision
ExecStart=/home/kensan/Projects/Mirai-DX-Project/Civil-Weather-Water-Decision/deploy/scripts/public-edge-access-check.sh --base-url https://cwwd.mirai-dx-platform.com --path / --path /api/sites --path /health --path /readyz --path /docs --path /openapi.json --expected-statuses 302 --location-contains cloudflareaccess.com/cdn-cgi/access/login --timeout-seconds 10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
