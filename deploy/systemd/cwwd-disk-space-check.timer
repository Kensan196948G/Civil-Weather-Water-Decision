[Unit]
Description=Hourly Civil-Weather-Water-Decision disk space check
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/deploy.md

[Timer]
OnBootSec=3min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
AccuracySec=1min
Persistent=false
Unit=cwwd-disk-space-check.service

[Install]
WantedBy=timers.target
