[Unit]
Description=Civil-Weather-Water-Decision application health check
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/deploy.md
After=network-online.target cwwd-backend.service cwwd-frontend.service cwwd-tunnel.service
Wants=network-online.target
OnFailure=cwwd-ops-failure@%n.service

[Service]
Type=oneshot
User=kensan
Group=kensan
ExecStart=/home/kensan/Projects/Mirai-DX-Project/Civil-Weather-Water-Decision/deploy/scripts/app-health-check.sh --backend-health-url http://127.0.0.1:55019/health --backend-ready-url http://127.0.0.1:55019/readyz --frontend-url http://127.0.0.1:34979/ --frontend-api-url http://127.0.0.1:34979/api/auth/me --public-url https://cwwd.mirai-dx-platform.com/ --public-statuses 302 --timeout-seconds 10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private
RemoveIPC=true
UMask=0077
