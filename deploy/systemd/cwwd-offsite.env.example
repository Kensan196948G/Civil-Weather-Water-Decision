# Copy to /home/kensan/.config/cwwd/offsite.env on the production host.
# Keep this file transfer-target only; do not include DB connection strings or app secrets.
# chmod 600 /home/kensan/.config/cwwd/offsite.env
#
# rclone remote name（rclone config で設定済みの remote。例: backup-bucket）
OFFSITE_REMOTE=my-backup-bucket
# 転送先パス
OFFSITE_PATH=cwwd/backups
# ローカル export ディレクトリ（省略時は /var/backups/cwwd/exports）
# OFFSITE_EXPORT_DIR=/var/backups/cwwd/exports
# 鮮度監視の許容時間（時間）
# OFFSITE_MAX_AGE_HOURS=28
