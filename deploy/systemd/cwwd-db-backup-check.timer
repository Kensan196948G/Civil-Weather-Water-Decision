[Unit]
Description=Hourly Civil-Weather-Water-Decision PostgreSQL backup freshness check
Documentation=https://github.com/Kensan196948G/Civil-Weather-Water-Decision/blob/main/docs/backup-restore.md

[Timer]
OnCalendar=*-*-* *:17:00
RandomizedDelaySec=10min
AccuracySec=2min
Persistent=true
Unit=cwwd-db-backup-check.service

[Install]
WantedBy=timers.target
